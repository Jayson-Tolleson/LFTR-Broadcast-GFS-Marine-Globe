#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo bash "$0" "$@"
fi

REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
if [[ "$REAL_USER" == "root" ]]; then
  REAL_HOME="/root"
else
  REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
fi
REAL_HOME="${REAL_HOME:-/home/$REAL_USER}"
DEST_DIR="$REAL_HOME/broadcast"
STAGE="$(mktemp -d /tmp/lftr-globe.XXXXXX)"
PAYLOAD_ZIP="$STAGE/payload.zip"

cleanup() { rm -rf "$STAGE"; }
trap cleanup EXIT

if command -v apt-get >/dev/null 2>&1; then
  apt-get update -y
  DEBIAN_FRONTEND=noninteractive apt-get install -y unzip curl ca-certificates tar
fi

awk 'BEGIN{found=0} /^__LFTR_ZIP_PAYLOAD_BELOW__$/ {found=1; next} found {print}' "$0" | base64 -d > "$PAYLOAD_ZIP"

mkdir -p "$STAGE/src" "$DEST_DIR"
unzip -q "$PAYLOAD_ZIP" -d "$STAGE/src"
find "$DEST_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
(cd "$STAGE/src" && tar --exclude='./.git' --exclude='./__pycache__' -cf - .) | (cd "$DEST_DIR" && tar -xf -)

chown -R "$REAL_USER:$REAL_USER" "$DEST_DIR" 2>/dev/null || true
chmod +x "$DEST_DIR/broadcast.sh" "$DEST_DIR/install.sh" "$DEST_DIR/deploy/install.sh" "$DEST_DIR/INSTALL_NOW.sh" 2>/dev/null || true

cd "$DEST_DIR"
echo "LFTR package extracted and staged in $DEST_DIR"
echo "Starting installer from $(pwd)"
exec bash ./broadcast.sh "$@"

